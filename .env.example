# Copy this file to .env (same folder) and paste your keys after the = signs.
# .env is git-ignored and is never printed or committed.

# ChatGPT arm: OpenAI Responses API with the web_search tool (platform.openai.com > API keys; add ~US$20 credit)
OPENAI_API_KEY=

# Gemini arm: Gemini API with Google Search grounding (aistudio.google.com > Get API key; enable billing to avoid free-tier rate limits)
GEMINI_API_KEY=

# Perplexity arm: Sonar API (perplexity.ai > Settings > API; add ~US$5 credit)
PERPLEXITY_API_KEY=

# Google AI Overviews arm: SerpApi (serpapi.com; Starter plan, 1,000 searches/month)
SERPAPI_API_KEY=

# Response coder (kept independent of the four audited vendors): Anthropic API (console.anthropic.com; add ~US$20 credit)
ANTHROPIC_API_KEY=
